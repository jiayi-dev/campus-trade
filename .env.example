# ============================================================
# Docker 部署环境变量示例
# ------------------------------------------------------------
# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，绝对不要提交到 Git。
# MySQL 的 :? 语法会在变量缺失时直接报错退出，避免危险默认值。
# ============================================================

# ---- MySQL（独立演示实例，不对宿主机暴露端口） ----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=campus
MYSQL_PASSWORD=change-me-app-password

# ---- AI 助手（可留空，留空时自动降级为关键词问答） ----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-max-0902

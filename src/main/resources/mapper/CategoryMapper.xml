<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jiayi.campustrade.mapper.CategoryMapper">

    <!-- 查询全部分类 -->
    <select id="findAll"
            resultType="com.jiayi.campustrade.entity.Category">

        SELECT
        category_id,
        category_name,
        create_time
        FROM category
        ORDER BY category_id ASC

    </select>

</mapper>

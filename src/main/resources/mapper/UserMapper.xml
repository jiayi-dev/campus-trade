<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jiayi.campustrade.mapper.UserMapper">

    <!-- 根据手机号查询用户 -->
    <select id="findByPhone"
            resultType="com.jiayi.campustrade.entity.User">

        SELECT *
        FROM user
        WHERE phone = #{phone}

    </select>


    <!-- 插入新用户 -->
    <insert id="insert">

        INSERT INTO user
        (username, password, phone, email, role, status, create_time)
        VALUES
        (#{username}, #{password}, #{phone}, #{email}, #{role}, #{status}, NOW())

    </insert>


    <!-- 根据用户ID查询用户 -->
    <select id="findById"
            resultType="com.jiayi.campustrade.entity.User">

        SELECT *
        FROM user
        WHERE user_id = #{id}

    </select>

    <!-- 根据用户名查询用户 -->
    <select id="findByUsername"
            resultType="com.jiayi.campustrade.entity.User">

        SELECT *
        FROM user
        WHERE username = #{username}

    </select>


    <!--
        管理员用户分页查询
        显式列出字段，不查询 password（@JsonProperty WRITE_ONLY 也会兜底，双保险）
    -->
    <select id="findPage"
            resultType="com.jiayi.campustrade.entity.User">

        SELECT
        user_id,
        username,
        phone,
        email,
        role,
        status,
        create_time
        FROM user

        <where>

            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>

            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>

            <if test="role != null and role != ''">
                AND role = #{role}
            </if>

            <if test="status != null">
                AND status = #{status}
            </if>

        </where>

        ORDER BY user_id ASC
        LIMIT #{offset}, #{pageSize}

    </select>


    <!-- 管理员用户总数 -->
    <select id="count"
            resultType="int">

        SELECT COUNT(*)
        FROM user

        <where>

            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>

            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>

            <if test="role != null and role != ''">
                AND role = #{role}
            </if>

            <if test="status != null">
                AND status = #{status}
            </if>

        </where>

    </select>


    <!-- 启用/禁用用户：只更新 status -->
    <update id="updateStatus">

        UPDATE user
        SET status = #{status}
        WHERE user_id = #{userId}

    </update>


    <!-- 卖家申请审核通过：只更新 role -->
    <update id="updateRole">

        UPDATE user
        SET role = #{role}
        WHERE user_id = #{userId}

    </update>

</mapper>
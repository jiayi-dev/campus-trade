<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jiayi.campustrade.mapper.UserMapper">

    <!-- 根据手机号查询用户 -->
    <select id="findByPhone"
            resultType="com.jiayi.campustrade.entity.User">

        SELECT *
        FROM user
        WHERE phone = #{phone}

    </select>


    <!-- 插入新用户 -->
    <insert id="insert">

        INSERT INTO user
        (username, password, phone, email, role, status, create_time)
        VALUES
        (#{username}, #{password}, #{phone}, #{email}, #{role}, #{status}, NOW())

    </insert>


    <!-- 根据用户ID查询用户 -->
    <select id="findById"
            resultType="com.jiayi.campustrade.entity.User">

        SELECT *
        FROM user
        WHERE user_id = #{id}

    </select>

    <!-- 根据用户名查询用户 -->
    <select id="findByUsername"
            resultType="com.jiayi.campustrade.entity.User">

        SELECT *
        FROM user
        WHERE username = #{username}

    </select>

</mapper>